<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/focus_setup_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.focus.FocusSetupActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/btn_start"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingTop="@dimen/spacing_lg"
            android:paddingBottom="@dimen/spacing_md">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/focus_title"
                android:textAppearance="@style/TextAppearance.Modity.Display" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/focus_subtitle"
                android:textAppearance="@style/TextAppearance.Modity.Caption" />

            <TextView
                android:id="@+id/tv_duration_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/spacing_xl"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Modity.Timer"
                tools:text="25:00" />

            <TextView
                style="@style/Widget.Modity.SectionLabel"
                android:layout_marginTop="0dp"
                android:text="@string/label_task" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_task"
                style="@style/Widget.Modity.TextInput.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <AutoCompleteTextView
                    android:id="@+id/act_task"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    tools:ignore="LabelFor" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Widget.Modity.SectionLabel"
                android:text="@string/label_duration" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_duration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true" />

            <TextView
                style="@style/Widget.Modity.SectionLabel"
                android:text="@string/label_options" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_dnd"
                style="@style/Widget.Modity.Switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/focus_dnd" />

            <TextView
                android:id="@+id/tv_dnd_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/focus_dnd_hint"
                android:textAppearance="@style/TextAppearance.Modity.Caption" />

            <TextView
                android:id="@+id/tv_focus_today"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:drawablePadding="@dimen/spacing_sm"
                android:gravity="center_vertical"
                android:textAppearance="@style/TextAppearance.Modity.Caption"
                app:drawableStartCompat="@drawable/ic_timer"
                app:drawableTint="?attr/colorOnSurfaceVariant"
                tools:text="Today: 2 sessions · 50m" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_start"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_padding"
        android:layout_marginBottom="12dp"
        android:text="@string/focus_start"
        app:icon="@drawable/ic_play"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:dividerColor="?attr/colorOutlineVariant"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav_menu" />
</androidx.constraintlayout.widget.ConstraintLayout>
