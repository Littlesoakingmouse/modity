<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/calendar_cell"
    android:layout_width="match_parent"
    android:layout_height="@dimen/calendar_cell_height"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_calendar_day"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_calendar_day"
        android:gravity="center"
        android:textColor="@color/selector_toggle_text"
        android:textSize="14sp"
        tools:text="11" />

    <View
        android:id="@+id/view_calendar_dot"
        android:layout_width="@dimen/dot_size"
        android:layout_height="@dimen/dot_size"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_circle" />
</LinearLayout>
