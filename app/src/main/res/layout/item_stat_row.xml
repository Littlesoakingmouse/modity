<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/spacing_md"
    android:paddingVertical="12dp">

    <ImageView
        android:id="@+id/iv_row_badge"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_rounded"
        android:importantForAccessibility="no"
        android:padding="7dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/ic_task_book" />

    <TextView
        android:id="@+id/tv_row_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Modity.Body"
        app:layout_constraintEnd_toStartOf="@id/tv_row_value"
        app:layout_constraintStart_toEndOf="@id/iv_row_badge"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="0dp"
        tools:text="Study" />

    <TextView
        android:id="@+id/tv_row_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:fontFamily="sans-serif-medium"
        android:textAppearance="@style/TextAppearance.Modity.Body"
        app:layout_constraintBaseline_toBaselineOf="@id/tv_row_title"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="72%" />

    <TextView
        android:id="@+id/tv_row_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.Modity.Caption"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/tv_row_title"
        app:layout_constraintTop_toBottomOf="@id/tv_row_title"
        tools:text="18 of 25 completed" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_row"
        style="@style/Widget.Modity.Progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:max="100"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/tv_row_title"
        app:layout_constraintTop_toBottomOf="@id/tv_row_subtitle" />
</androidx.constraintlayout.widget.ConstraintLayout>
