<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/task_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:minHeight="60dp"
    android:paddingStart="@dimen/spacing_sm"
    android:paddingEnd="@dimen/spacing_xs">

    <FrameLayout
        android:id="@+id/check_container"
        android:layout_width="@dimen/touch_target"
        android:layout_height="@dimen/touch_target"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/desc_toggle_done"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_check"
            android:layout_width="@dimen/check_size"
            android:layout_height="@dimen/check_size"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:padding="5dp" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_task_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_xs"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.Modity.Body"
        app:layout_constraintBottom_toTopOf="@id/tv_task_meta"
        app:layout_constraintEnd_toStartOf="@id/tv_task_status"
        app:layout_constraintStart_toEndOf="@id/check_container"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="Read 20 pages" />

    <TextView
        android:id="@+id/tv_task_meta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Modity.Caption"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/tv_task_title"
        app:layout_constraintStart_toStartOf="@id/tv_task_title"
        app:layout_constraintTop_toBottomOf="@id/tv_task_title"
        tools:text="09:00  ·  Mon, Wed, Fri" />

    <TextView
        android:id="@+id/tv_task_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:textAppearance="@style/TextAppearance.Modity.Caption"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_task_more"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Missed"
        tools:visibility="visible" />

    <ImageButton
        android:id="@+id/btn_task_more"
        android:layout_width="40dp"
        android:layout_height="@dimen/touch_target"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/desc_more"
        android:src="@drawable/ic_more_vert"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/colorOnSurfaceVariant" />
</androidx.constraintlayout.widget.ConstraintLayout>
