<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.home.HomeActivity">

    <TextView
        android:id="@+id/tv_home_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginTop="@dimen/spacing_md"
        android:background="?attr/selectableItemBackground"
        android:drawablePadding="@dimen/spacing_xs"
        android:paddingVertical="@dimen/spacing_xs"
        android:textAppearance="@style/TextAppearance.Modity.Label"
        app:drawableEndCompat="@drawable/ic_expand"
        app:drawableTint="?attr/colorOnSurfaceVariant"
        app:layout_constraintEnd_toStartOf="@id/btn_search"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="wrap"
        tools:text="Saturday, 11 October" />

    <TextView
        android:id="@+id/tv_home_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:textAppearance="@style/TextAppearance.Modity.Display"
        app:layout_constraintEnd_toStartOf="@id/btn_search"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_home_date"
        tools:text="Today" />

    <ImageButton
        android:id="@+id/btn_search"
        android:layout_width="@dimen/touch_target"
        android:layout_height="@dimen/touch_target"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/search"
        android:src="@drawable/ic_search"
        app:layout_constraintEnd_toStartOf="@id/btn_settings"
        app:layout_constraintTop_toTopOf="@id/tv_home_date" />

    <ImageButton
        android:id="@+id/btn_settings"
        android:layout_width="@dimen/touch_target"
        android:layout_height="@dimen/touch_target"
        android:layout_marginEnd="@dimen/spacing_sm"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/settings"
        android:src="@drawable/ic_settings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_home_date" />

    <TextView
        android:id="@+id/tv_home_summary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:textAppearance="@style/TextAppearance.Modity.Caption"
        app:layout_constraintEnd_toStartOf="@id/tv_home_percent"
        app:layout_constraintStart_toStartOf="@id/tv_home_title"
        app:layout_constraintTop_toBottomOf="@id/tv_home_title"
        tools:text="3 of 7 tasks done" />

    <TextView
        android:id="@+id/tv_home_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/screen_padding"
        android:textAppearance="@style/TextAppearance.Modity.Caption"
        app:layout_constraintBaseline_toBaselineOf="@id/tv_home_summary"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="43%" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_day"
        style="@style/Widget.Modity.Progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginTop="@dimen/spacing_sm"
        android:layout_marginEnd="@dimen/screen_padding"
        android:max="100"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_home_summary" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_week"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_md"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progress_day"
        tools:itemCount="7"
        tools:listitem="@layout/item_week_day" />

    <TextView
        android:id="@+id/tv_plan_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:text="@string/home_plan"
        android:textAppearance="@style/TextAppearance.Modity.Label"
        app:layout_constraintBottom_toBottomOf="@id/toggle_home_style"
        app:layout_constraintEnd_toStartOf="@id/toggle_home_style"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/toggle_home_style" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggle_home_style"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:layout_marginEnd="@dimen/screen_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rv_week"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_style_card"
            style="@style/Widget.Modity.Toggle.Icon"
            android:contentDescription="@string/style_card"
            app:icon="@drawable/ic_view_card" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_style_grid"
            style="@style/Widget.Modity.Toggle.Icon"
            android:contentDescription="@string/style_grid"
            app:icon="@drawable/ic_view_grid" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_style_timeline"
            style="@style/Widget.Modity.Toggle.Icon"
            android:contentDescription="@string/style_timeline"
            app:icon="@drawable/ic_view_timeline" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_home"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_sm"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_xs"
        android:paddingBottom="@dimen/list_bottom_padding"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toggle_home_style" />

    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/spacing_xl"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toggle_home_style"
        tools:visibility="visible">

        <ImageView
            android:layout_width="@dimen/icon_badge_lg"
            android:layout_height="@dimen/icon_badge_lg"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_task_check"
            app:tint="?attr/colorOutline" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/home_empty_title"
            android:textAppearance="@style/TextAppearance.Modity.Title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:gravity="center"
            android:text="@string/home_empty_message"
            android:textAppearance="@style/TextAppearance.Modity.Caption" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_add_task"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/screen_padding"
        android:contentDescription="@string/add_task"
        app:backgroundTint="?attr/colorPrimary"
        app:elevation="2dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Modity.Fab"
        app:srcCompat="@drawable/ic_add"
        app:tint="?attr/colorOnPrimary" />

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:dividerColor="?attr/colorOutlineVariant"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav_menu" />
</androidx.constraintlayout.widget.ConstraintLayout>
