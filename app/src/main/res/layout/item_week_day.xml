<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/week_day"
    android:layout_width="@dimen/week_day_width"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:background="@drawable/bg_week_day"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingVertical="@dimen/spacing_sm">

    <TextView
        android:id="@+id/tv_weekday"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:textAppearance="@style/TextAppearance.Modity.Caption"
        android:textColor="@color/selector_week_secondary"
        android:textSize="12sp"
        tools:text="Sat" />

    <TextView
        android:id="@+id/tv_day_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:duplicateParentState="true"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/selector_toggle_text"
        android:textSize="17sp"
        tools:text="11" />
</LinearLayout>
