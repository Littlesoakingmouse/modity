<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ShapeAppearance.Modity.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_sm</item>
    </style>

    <style name="Widget.Modity.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/corner_md</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">@dimen/stroke_thin</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
    </style>

    <style name="Widget.Modity.Button" parent="Widget.Material3.Button">
        <item name="iconGravity">textStart</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAppearance">@style/TextAppearance.Modity.Button</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Modity.Small</item>
    </style>

    <style name="Widget.Modity.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="iconGravity">textStart</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAppearance">@style/TextAppearance.Modity.Button</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="iconTint">?attr/colorOnSurface</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Modity.Small</item>
    </style>

    <style name="Widget.Modity.Toggle" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">40dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Modity.Caption</item>
        <item name="android:textColor">@color/selector_toggle_text</item>
        <item name="iconTint">@color/selector_toggle_text</item>
        <item name="backgroundTint">@color/selector_toggle_bg</item>
        <item name="strokeColor">?attr/colorOutline</item>
    </style>

    <style name="Widget.Modity.Toggle.Icon">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:minWidth">44dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">20dp</item>
    </style>

    <style name="Widget.Modity.SectionLabel" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/spacing_lg</item>
        <item name="android:layout_marginBottom">@dimen/spacing_sm</item>
        <item name="android:textAppearance">@style/TextAppearance.Modity.Label</item>
    </style>

    <style name="Widget.Modity.PickerField" parent="">
        <item name="android:focusable">false</item>
        <item name="android:clickable">true</item>
        <item name="android:cursorVisible">false</item>
        <item name="android:inputType">none</item>
    </style>

    <style name="ShapeAppearance.Modity.Fab" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_md</item>
    </style>

    <style name="Widget.Modity.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/corner_sm</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_sm</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_sm</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_sm</item>
        <item name="boxStrokeColor">?attr/colorOnSurface</item>
        <item name="hintTextColor">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.Modity.TextInput.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">@dimen/corner_sm</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_sm</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_sm</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_sm</item>
        <item name="boxStrokeColor">?attr/colorOnSurface</item>
        <item name="hintTextColor">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.Modity.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.Modity.Title</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="Widget.Modity.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">?attr/colorSurface</item>
        <item name="backgroundTint">@null</item>
        <item name="elevation">0dp</item>
        <item name="itemIconTint">@color/selector_nav_item</item>
        <item name="itemTextColor">@color/selector_nav_item</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Modity.BottomNav.Indicator</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="Widget.Modity.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/colorSurfaceVariant</item>
    </style>

    <style name="Widget.Modity.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/selector_toggle_bg</item>
        <item name="android:textColor">@color/selector_toggle_text</item>
        <item name="chipStrokeColor">?attr/colorOutline</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipCornerRadius">@dimen/corner_sm</item>
    </style>

    <style name="Widget.Modity.Progress" parent="Widget.Material3.LinearProgressIndicator">
        <item name="trackThickness">@dimen/progress_track</item>
        <item name="trackCornerRadius">@dimen/progress_track</item>
        <item name="trackColor">?attr/colorSurfaceVariant</item>
        <item name="indicatorColor">?attr/colorOnSurface</item>
        <item name="trackStopIndicatorSize">0dp</item>
        <item name="indicatorTrackGapSize">0dp</item>
    </style>

    <style name="Widget.Modity.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:textAppearance">@style/TextAppearance.Modity.Body</item>
        <item name="android:minHeight">@dimen/touch_target</item>
    </style>

    <style name="TextAppearance.Modity.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Modity.Headline" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Modity.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Modity.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Modity.Caption" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.Modity.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.Modity.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.Modity.Number" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Modity.Timer" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:textSize">64sp</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
</resources>
